X=np.linspace(-5,5,100).reshape(-1,1)

Y=3*X+4+np.random.rand(100,1)


iterations=500

lr=0.1

loss_history=[]

theta=np.random.randn(2,1)
X_b=np.c_[X,np.ones((100,1))]

for epoch in range(iterations):
  y=np.matmul(X_b,theta)

  loss=np.mean((y-Y)**2)

  loss_history.append(loss)

  theta-=lr*(1/(X.shape[0]))*np.matmul(X_b.T,(y-Y))

 

plt.plot(X,Y,color='red',label="real line")
plt.plot(X,np.matmul(X_b,theta),linestyle='dashed',color='blue',label="predicted line")
plt.legend()


# Observations:
# With noise the number of iterations it takes to learn the pattern is higher.
# A learning rate of 0.1 is good enough for this.
