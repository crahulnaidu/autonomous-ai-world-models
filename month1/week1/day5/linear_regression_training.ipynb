X1=np.random.rand(100,1)
X2=200*(1+np.random.rand(100,1))

X=np.concatenate((X1,X2),axis=-1)

Y=3*X1+4*X2+np.random.rand(100,1)

X_b=np.c_[X,np.ones((100,1))]


from sklearn.preprocessing import StandardScaler

scale=StandardScaler()

epochs=100

diff=1e-3

conv_speed_without_scale=0

lr=0.1

m=100

loss_history=[]
theta=np.random.rand(3,1)

loss_history.append(np.mean((X_b.dot(theta)-Y)**2))



for epoch in range(epochs):
  grad=(2/m)*X_b.T.dot(X_b.dot(theta)-Y)

  loss=np.mean((X_b.dot(theta)-Y)**2)


  loss_history.append(loss)

  theta-=lr*grad

  if loss<diff:
    conv_speed_without_scale=epoch
    break



x_new=scale.fit_transform(X)

conv_speed_with_scale=0

x_new=np.c_[x_new,np.ones((100,1))]

theta_scale=np.random.rand(3,1)

loss_history=[]

loss_history.append(np.mean((x_new.dot(theta)-Y)**2))


for epoch in range(epochs):
  grad=(2/m)*x_new.T.dot((x_new.dot(theta)-Y))

  theta-=lr*grad

  loss=np.mean((x_new.dot(theta)-Y)**2)

  loss_history.append(loss)

  if loss<diff:
    conv_speed_without_scale=epoch
    break

  
print(conv_speed_without_scale,conv_speed_with_scale)
