##Comparing MSE and MAE for a simple linear regression.


X=np.random.rand(100,1)

Y=4+3*X+np.random.rand(100,1)

theta=np.random.randn(2,1)

X_b=np.c_[X,np.ones((100,1))]

epochs=300

lr=0.1

loss_hist_mse=[]
loss_hist_mae=[]

for epoch in range(epochs):
  y=X_b.dot(theta)

  loss_mse=np.mean((y-Y)**2)

  loss_mae=np.mean(abs(y-Y))

  loss_hist_mse.append(loss_mse)

  loss_hist_mae.append(loss_mae)

  theta-=lr*1/(X.shape[0])*X_b.T.dot(y-Y)


plt.plot(loss_hist_mae,range(epochs),color='blue',label="MSE error")

plt.plot(loss_hist_mse,range(epochs),color='red',linestyle='dashed',label="MAE error")
plt.legend()

##Adding an outlier

X=np.append(X,200*np.random.rand(1,1)).reshape(-1,1)

Y=4+3*X+np.random.rand(101,1)

theta=np.random.randn(2,1)

X_b=np.c_[X,np.ones((101,1))]

epochs=300

lr=0.1

loss_hist_mse=[]
loss_hist_mae=[]

for epoch in range(epochs):
  y=X_b.dot(theta)

  loss_mse=np.mean((y-Y)**2)

  loss_mae=np.mean(abs(y-Y))

  loss_hist_mse.append(loss_mse)

  loss_hist_mae.append(loss_mae)

  theta-=lr*1/(X.shape[0])*X_b.T.dot(y-Y)

plt.plot(loss_hist_mae,range(epochs),color='blue',label="MSE error")

plt.plot(loss_hist_mse,range(epochs),color='red',linestyle='dashed',label="MAE error")
plt.legend()

## For outlier's MSE change's a lot because of the square term in its function compared to MAE.
